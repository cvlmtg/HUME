;;; init.scm.example — HUME Steel configuration starter
;;;
;;; Copy to ~/.config/hume/init.scm (or $XDG_CONFIG_HOME/hume/init.scm) on
;;; macOS/Linux, or %APPDATA%\hume\init.scm on Windows, and edit to taste.
;;; Evaluated once at startup; :reload-config re-applies changes.

;; ── Plugins ───────────────────────────────────────────────────────────────────
;; Everything below is a core plugin, loaded so every bundled feature is on by
;; default. Read user-manual/docs/core-plugins.md (or each plugin's own
;; README under runtime/plugins/core/<name>/) before keeping or dropping one —
;; a few rebind the same keys, so know what you're enabling.

(load-plugin "core:stdlib")           ; helper toolkit other plugins depend on
(load-plugin "core:pickers")          ; fuzzy file/buffer finders
(declare-plugin "core:lsp")           ; language server features
(declare-plugin "core:plum")          ; plugin/grammar manager
(declare-plugin "core:git-diff")      ; live inline git diff

;; (load-plugin "core:vim-keybind")      ; vim muscle memory
;; (load-plugin "core:helix-surround")   ; helix-style surround
;; (load-plugin "core:classic-paste")    ; GUI-style paste

;; ── Your settings & key bindings ─────────────────────────────────────────────
;; Full reference:
;; user-manual/docs/configuration.md (options + key bindings)
;; user-manual/docs/plugins.md (custom commands, hooks).
;;
;;   (set-option! "tab-width" 2) ; sets a global option:
;;   (bind-key! 'normal "space d" "lsp-hover") ; adds a key binding.
;;
;; "space" is free by default, so it's a natural prefix for your own bindings:
