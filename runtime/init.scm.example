;;; init.scm.example — HUME Steel configuration starter
;;;
;;; Copy this file to ~/.config/hume/init.scm (or $XDG_CONFIG_HOME/hume/init.scm)
;;; and edit to taste.  HUME evaluates it once at startup; use :reload-config
;;; to apply changes without restarting.
;;;
;;; Steel is a Scheme dialect. Press : then Tab to list all built-in commands.
;;; Full reference: user-manual/docs/configuration.md and plugins.md.

;; ── Settings ──────────────────────────────────────────────────────────────────
;; (set-option! key value) — see configuration.md for the full option list.

(set-option! "tab-width" 2)
;; (set-option! "line-number-style" "relative")
;; (set-option! "scrolloff" 8)

;; ── Key bindings ──────────────────────────────────────────────────────────────
;; (bind-key! mode key-sequence command-name) — see configuration.md#key-bindings.

;; (bind-key! 'normal "U" "undo")

;; ── Custom commands ───────────────────────────────────────────────────────────
;; (define-command! name doc-string lambda [keyword-args...]) — see plugins.md.

;; (define-command! "hello"
;;   "Log a greeting to the message log."
;;   (lambda ()
;;     (log! 'info "Hello from init.scm!")))

;; ── Plugins ───────────────────────────────────────────────────────────────────
;;   (declare-plugin name keyword-args...) — lazy: load on first activation.
;;   (load-plugin name)                    — eager: load now, at startup.
;; See plugins.md and core-plugins.md.

;; (declare-plugin "core:stdlib")      ; helpers other plugins need — see core:stdlib README "Caveat"
;; (load-plugin "core:stdlib")         ; same, eagerly — required by some dependents (e.g. core:vim-keybind)
;; (declare-plugin "core:plum")        ; plugin/grammar manager
;; (load-plugin "core:plum")           ; same, eagerly — see core:plum README "Caveat"
;; (load-plugin "core:pickers")        ; fuzzy file/buffer finders on g f / g b — eager (binds keys)

;; Third-party plugins, installed by :plum-install:
;; (load-plugin "alice/my-theme")

;; ── LSP ───────────────────────────────────────────────────────────────────────
;; Language servers — see user-manual/docs/lsp.md for setup and per-language examples.
;; core:lsp alone is enough: run :lsp-install (per language) to download, verify,
;; register, and attach a server automatically — no manual registration below needed
;; for a seeded server.
;;
;; core:lsp can be declared lazily — the one-liner below activates on the first
;; buffer with a detected language, or the first lsp-* command typed, whichever
;; comes first (server attach is never itself a trigger). Customize activation
;; yourself (name specific #:languages, pick a subset of #:commands, ...) by
;; passing those keywords explicitly instead — see README.md in
;; runtime/plugins/core/lsp/ for the full trigger list.
;;
;; (declare-plugin "core:lsp")
;;
;; A manual registration always overrides an :lsp-install-managed one — use it for a
;; local build, a version the seeded catalog doesn't carry, or to prefer a $PATH copy.
;; Note: :lsp-status/:lsp-stop/:lsp-restart are core:lsp commands too — a manual
;; register-lsp-server! call with no core:lsp loaded gets a running server but no
;; way to inspect/stop/restart it from the command line:
;; (register-lsp-server! "rust" #:command "rust-analyzer" #:root-markers '("Cargo.toml"))
