;;; init.scm.example — HUME Steel configuration reference
;;;
;;; Copy this file to ~/.config/hume/init.scm (or $XDG_CONFIG_HOME/hume/init.scm)
;;; and edit to taste.  HUME evaluates it once at startup; use :reload-config
;;; to apply changes without restarting.
;;;
;;; Steel is a Scheme dialect — Scheme syntax applies throughout.
;;; Run :commands to list all available built-in commands.

;; ── Settings ──────────────────────────────────────────────────────────────────
;;
;; (set-option! key value)
;; Valid keys and their defaults:
;;   "tab-width"          integer   4        — spaces per indent level
;;   "auto-pairs-enabled" bool      #t       — insert matching close delimiter
;;   "line-number-style"  string    "hybrid" — "absolute", "relative", "hybrid"
;;   "wrap-mode"          string    "indent" — "none", "word", "indent"
;;   "scrolloff"          integer   3        — lines kept above/below cursor
;;   "mouse-enabled"      bool      #t       — enable mouse support
;;   "mouse-select"       bool      #f       — mouse drag creates a selection

(set-option! "tab-width" 2)
;; (set-option! "auto-pairs-enabled" #f)
;; (set-option! "line-number-style" "relative")

;; ── Statusline ────────────────────────────────────────────────────────────────
;;
;; (configure-statusline! left center right)
;; Each section is a list of element name strings.  Valid names:
;;   "Mode"  "Separator"  "FileName"  "Position"  "Selections"
;;   "DirtyIndicator"  "SearchMatches"  "MiniBuf"  "MacroRecording"
;;   "KittyProtocol"
;;
;; The call below reproduces the default layout.
(configure-statusline!
  '("Mode" "DirtyIndicator" "Separator" "FileName")       ; left
  '()                                                     ; center
  '("Position" "Selections" "MiniBuf" "MacroRecording"))  ; right

;; ── Key bindings ──────────────────────────────────────────────────────────────
;;
;; (bind-key! mode key-sequence command-name)
;;   mode          — "normal", "insert", or "extend"
;;   key-sequence  — space-separated tokens: "g h", "ctrl-f", "alt-x", "f1"
;;   command-name  — any command name visible in :commands
;;
;; (bind-wait-char! mode key-sequence command-name)
;;   Like bind-key! but the next keypress is captured as the wait-char argument.
;;   Used for surround-style "verb + char" bindings.
;;
;; Ergonomic batch variants are also available:
;;
;; (bind-keys! mode (key cmd) ...)
;;   Bind multiple keys at once — expands to individual bind-key! calls.
;;
;; (bind-keys-extend! mode (key cmd) ...)
;;   Like bind-keys! but each leaf is a force-extend binding.
;;
;; (unbind-keys! mode key ...)
;;   Remove multiple bindings at once.
;;
;; Example — bind several normal-mode keys in one call:
;; (bind-keys! "normal"
;;   ("U"          "undo")
;;   ("ctrl-enter" "open-below"))

;; Re-map 'U' in normal mode to undo for muscle-memory from other editors.
;; (bind-key! "normal" "U" "undo")

;; Open a new line below and enter insert mode with Ctrl-Enter.
;; (bind-key! "normal" "ctrl-enter" "open-below")

;; ── Custom commands ───────────────────────────────────────────────────────────
;;
;; (define-command! name doc-string (lambda () body...))
;; (define-command-extend! name doc-string (lambda () body...))
;;   Same as define-command!, but marks the command as extendable so that
;;   Ctrl+<key> still works after you rebind the bare letter.  Use this for
;;   commands that end in a motion or selection step.
;; (define-command-inline-output! name doc-string (lambda () body...))
;;   Same as define-command!, but exits the alt-screen before the command runs
;;   so that subprocess output (install scripts, formatters, linters) streams
;;   live to the terminal.  After the command finishes, press any key to return
;;   to the editor.  Use this for any command that shells out with output you
;;   want to read (e.g. plum install, cargo fmt).
;; (define-command-repeatable! name doc-string (lambda () body...))
;;   Same as define-command!, but opts the command into dot-repeat (`.`).
;;   Use only for self-contained buffer edits that make sense to repeat at a
;;   new cursor position.  Avoid for toggles, pickers, or navigation commands.
;;   If the command enters Insert mode (e.g. via `(call! "insert-before")`),
;;   text typed during that session is recorded and re-typed on `.`.  Any
;;   selection made *before* invoking the command (e.g. a `w` in the keymap)
;;   is also captured and re-established first.
;;
;; The command becomes available as ":name" in the command bar.
;; Use (call! "other-command") or (call! "cmd" arg1 arg2…) to invoke any
;; command — built-in or defined by you / another plugin.  All command
;; invocation is by name; positional args are passed as-is to the lambda.
;; Use (log! severity message) to post messages to :messages.
;;   severity — 'trace 'info 'warning 'error

(define-command! "hello"
  "Log a greeting to the message log."
  (lambda ()
    (log! 'info "Hello from init.scm!")))

;; Rebind `p` to always paste from the kill-ring head ("kp).
;; (set-register-prefix! name) arms a sticky register prefix for all following
;; (call! …) calls in the body — it persists until you call set-register-prefix!
;; again with a different register.  Valid names: "0"–"9", "k", "c", "b".
;;
;; (define-command! "paste-ring"
;;   "Paste from the kill-ring head (same as \\\"kp)."
;;   (lambda ()
;;     (set-register-prefix! "k")
;;     (call! "paste-after")))
;; (bind-key! "normal" "p" "paste-ring")
;;
;; Or load the bundled plugin for the full p/P + Ctrl+V split:
;;   (load-plugin "core:classic-paste")
;;
;; Tip: multiple calls after one set-register-prefix! all inherit the same
;; register, so you can do e.g.:
;;   (set-register-prefix! "5")
;;   (call! "yank")             ; yanks into register 5
;;   (set-register-prefix! "k")
;;   (call! "paste-after")      ; pastes from kill ring

;; Move down/up and immediately select the word under the new cursor position.
;; Uses define-command-extend! so Ctrl-J / Ctrl-K still work (one-shot extend).
;;
;; (define-command-extend! "move-down-select-word"
;;   "Move down one visual line, then select the nearest word on that line."
;;   (lambda ()
;;     (call! "move-down")
;;     (call! "select-word-nearest-on-line")))
;;
;; (define-command-extend! "move-up-select-word"
;;   "Move up one visual line, then select the nearest word on that line."
;;   (lambda ()
;;     (call! "move-up")
;;     (call! "select-word-nearest-on-line")))
;;
;; (bind-key! "normal" "j" "move-down-select-word")
;; (bind-key! "normal" "k" "move-up-select-word")

;; ── Plugins ───────────────────────────────────────────────────────────────────
;;
;; The verb encodes when the plugin loads:
;;
;;   (load-plugin name) — eager: load now, at startup.
;;   (declare-plugin name keyword-args...) — lazy: load on first trigger.
;;                               At least one keyword arg is required.
;;
;;   name — "core:name"   (bundled core plugin)
;;        — "user/repo"   (third-party plugin from
;;                         <data>/plugins/user/repo/plugin.scm)
;;
;; declare-plugin keyword args (all imply lazy loading):
;;
;;   #:on-command '("cmd-name" ...)
;;     Activate when one of these command names is first dispatched (via the
;;     command line or a key binding).
;;
;;   #:on-event '("hook-name" ...)
;;     Activate when one of the named lifecycle hooks fires.
;;     Valid hook names: on-buffer-open on-buffer-close on-buffer-save
;;                       on-edit on-mode-change
;;
;;   #:on-language '("lang-name" ...)
;;     Activate when the buffer language is set to one of the given names.
;;
;; Plugins cannot load or declare other plugins.  Declare every plugin you
;; need — including dependencies — at the top level of this file.
;;
;; :plugin-status (alias :plugins)
;;   Open a scratch view listing every declared plugin with its current state
;;   (waiting / loading / loaded / failed) and, for waiting plugins, the
;;   triggers still pending.  Use this to inspect lazy-load behaviour at
;;   runtime.
;;
;; core:plum           — plugin manager + grammar installer
;;                       Plugin commands: :plum-install, :plum-update, :plum-cleanup
;;                       Grammar commands: :plum-install-grammar, :plum-update-grammar,
;;                                         :plum-list-grammars, :plum-ensure-grammars,
;;                                         :plum-cleanup-grammars
;; core:helix-surround — md/mr surround shortcuts (bind-wait-char! already set)
;; core:classic-paste  — opt-in GUI-style paste split:
;;                       p/P → kill-ring head; Ctrl+V / Ctrl+Shift+V → OS clipboard
;;
;; Load plum first so it can install plugins and grammars.
;; PLUM registers any already-compiled grammars on load.
;; Install missing grammars explicitly:
;;
;;   (load-plugin "core:plum")
;;   (call! "plum-ensure-grammars" '("rust" "json"))   ; install listed grammars at startup
;;
;; Grammar install pipeline (requires git, curl, tree-sitter CLI on PATH):
;;   :plum-install-grammar  — install grammar for current buffer's language
;;   :plum-update-grammar   — re-clone + recompile (purges old source)
;;   :plum-ensure-grammars  — install listed grammars not yet compiled (list required)
;;   :plum-list-grammars    — show installed / declared / orphan / missing
;;   :plum-cleanup-grammars — delete orphan compiled grammars

;; (load-plugin "core:plum")

;; (load-plugin "core:helix-surround")
;; (load-plugin "core:classic-paste")

;; Declare third-party plugins to be installed by :plum-install.
;; PLUM installs declared plugins and reloads the config so they activate.
;; (load-plugin "alice/my-theme")
;; (load-plugin "bob/rust-extras")

;; Example: lazy-load a plugin when "my-cmd" is first dispatched.
;; The bind-key! below ensures pressing <space>m in Normal mode runs my-cmd,
;; which activates the plugin on first press.
;; (declare-plugin "alice/lazy-thing" #:on-command '("my-cmd"))
;; (bind-key! "normal" "<space>m" "my-cmd")
