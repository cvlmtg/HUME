;;; init.scm.example — HUME Steel configuration starter
;;;
;;; Copy this file to ~/.config/hume/init.scm (or $XDG_CONFIG_HOME/hume/init.scm)
;;; and edit to taste.  HUME evaluates it once at startup; use :reload-config
;;; to apply changes without restarting.
;;;
;;; Steel is a Scheme dialect. Run :commands to list all built-in commands.
;;; Full reference: user-manual/docs/configuration.md and plugins.md.

;; ── Settings ──────────────────────────────────────────────────────────────────
;; (set-option! key value) — see configuration.md for the full option list.

(set-option! "tab-width" 2)
;; (set-option! "line-number-style" "relative")
;; (set-option! "scrolloff" 8)

;; ── Key bindings ──────────────────────────────────────────────────────────────
;; (bind-key! mode key-sequence command-name) — see configuration.md#key-bindings.

;; (bind-key! 'normal "U" "undo")

;; ── Custom commands ───────────────────────────────────────────────────────────
;; (define-command! name doc-string lambda [keyword-args...]) — see plugins.md.

;; (define-command! "hello"
;;   "Log a greeting to the message log."
;;   (lambda ()
;;     (log! 'info "Hello from init.scm!")))

;; ── Plugins ───────────────────────────────────────────────────────────────────
;;   (load-plugin name)                    — eager: load now, at startup.
;;   (declare-plugin name keyword-args...) — lazy: load on first activation.
;; See plugins.md and core-plugins.md.

;; (load-plugin "core:stdlib")         ; selection-query helpers other plugins need
;; (load-plugin "core:plum")           ; plugin/grammar/language-server manager

;; Language servers — see user-manual/docs/lsp.md for setup and per-language examples.
;; With core:plum AND core:lsp both loaded, run :lsp-install (per language) to download,
;; register, and attach a server automatically — no manual registration below needed for
;; a seeded server. core:lsp does the registering; core:plum only downloads.
;;
;; core:lsp can be declared lazily, but #:events '("on-lsp-attach") alone never activates
;; from a PLUM-managed install — nothing is registered yet, so nothing attaches, so the
;; event never fires. Name the languages you rely on PLUM for in #:languages so opening a
;; matching file triggers activation directly (or just (load-plugin "core:lsp") eagerly):
;; (declare-plugin "core:lsp"
;;   #:events '("on-lsp-attach")
;;   #:languages '("rust")
;;   #:commands '("lsp-hover" "lsp-goto-definition" "lsp-goto-declaration"
;;                "lsp-goto-type-definition" "lsp-goto-implementation" "lsp-references"
;;                "goto-next-diagnostic" "goto-prev-diagnostic" "diagnostics"
;;                "lsp-rename" "lsp-fmt" "lsp-code-actions" "lsp-completion-trigger"))
;;
;; A manual registration always overrides a PLUM-managed one — use it for a local
;; build, a version PLUM doesn't carry, or to prefer a $PATH copy:
;; (register-lsp-server! "rust" #:command "rust-analyzer" #:root-markers '("Cargo.toml"))

;; Third-party plugins, installed by :plum-install:
;; (load-plugin "alice/my-theme")
